# --- Database (Supabase / AWS RDS Postgres) ---
DATABASE_URL="postgresql://chino:chino@localhost:5432/chino?schema=public"
DIRECT_URL="postgresql://chino:chino@localhost:5432/chino?schema=public"

# --- App ---
APP_URL="http://localhost:3000"

# --- Fonepay (issued by Fonepay on merchant onboarding) ---
FONEPAY_ENV="dev"                       # dev | live
FONEPAY_MERCHANT_CODE=""                # PID / merchantCode
FONEPAY_SECRET_KEY=""                   # HMAC-SHA512 key - never expose to the client
FONEPAY_QR_USERNAME=""                  # dynamic-QR API user
FONEPAY_QR_PASSWORD=""
# Override hosts only if Fonepay gives you different ones in your integration doc
FONEPAY_WEB_BASE_URL=""
FONEPAY_QR_BASE_URL=""
