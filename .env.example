# --- Database (Supabase / AWS RDS Postgres) ---
DATABASE_URL="postgresql://koseli:koseli@localhost:5432/koseli?schema=public"
DIRECT_URL="postgresql://koseli:koseli@localhost:5432/koseli?schema=public"

# --- App ---
APP_URL="http://localhost:3000"

# --- Fonepay (issued by Fonepay on merchant onboarding) ---
FONEPAY_ENV="dev"                       # dev | live
FONEPAY_MERCHANT_CODE=""                # PID / merchantCode
FONEPAY_SECRET_KEY=""                   # HMAC-SHA512 key - never expose to the client
FONEPAY_QR_USERNAME=""                  # dynamic-QR API user
FONEPAY_QR_PASSWORD=""
# Override hosts only if Fonepay gives you different ones in your integration doc
FONEPAY_WEB_BASE_URL=""
FONEPAY_QR_BASE_URL=""

# --- Stripe (diaspora card payments) ---
STRIPE_SECRET_KEY=""                    # sk_test_...
STRIPE_WEBHOOK_SECRET=""                # whsec_... from `stripe listen` or dashboard endpoint
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""   # pk_test_...

# --- FX ---
FX_BUFFER_BPS="300"                     # 3% cushion for card FX/cross-border fees
# FX_MANUAL_RATES='{"USD":"133.20","GBP":"169.10"}'   # optional override, NPR per 1 unit

# --- Cron ---
CRON_SECRET=""                          # random 32+ chars; Vercel sends it as a Bearer token

# --- Storefront ---
SESSION_SECRET=""                       # 32+ random chars; signs guest checkout cookies
DEMO_PAYMENTS="false"                   # "true" adds a Demo pay button that marks orders paid. Never on a public site.
